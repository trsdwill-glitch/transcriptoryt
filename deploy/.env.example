# Copy to deploy/.env, chmod 600; never upload credentials to version control.
# docker compose --env-file deploy/.env -f deploy/docker-compose.yml ...
DOMAIN=DOMAIN
CONTACT_EMAIL=CONTACT_EMAIL
ENV=production
PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
CF_ACCOUNT_ID=
CF_API_TOKEN=
SECRET_KEY=
HASH_SALT=
DATA_DIR=/data
# Audio minutes per user over a rolling 24-hour window, and per file.
DAILY_QUOTA_MIN=120
IP_QUOTA_MULTIPLIER=3
MAX_FILE_MIN=120
MAX_ITEMS=5
# Per-file limits in MiB. There is no total byte quota per user.
MAX_UPLOAD_MB=500
MAX_DOWNLOAD_MB=500
# MAX_ITEMS * MAX_UPLOAD_MB * 1048576 + 1048576, in bytes.
MAX_REQUEST_BODY=2622488576
DAILY_BUDGET_USD=0.50
# Estimate, not live provider billing. Review Groq pricing before opening service.
COST_PER_HOUR_USD=0.04
RESULT_TTL_S=3600
CHUNK_SECONDS=600
# Start conservatively on 2 vCPU / 4 GB. This is NOT a Uvicorn worker count.
MAX_CONCURRENT_JOBS=1
# Includes queue time; one 120-minute item plus waiting behind another job.
JOB_TIMEOUT_S=3600
PROVIDER_CONCURRENCY=2
TRUSTED_PROXY=true
YTDLP_HOSTS=youtube.com,www.youtube.com,m.youtube.com,music.youtube.com,youtu.be
YTDLP_PROXY=
YTDLP_COOKIES_FILE=
RATE_LIMIT_PER_MIN=60
JOBS_PER_HOUR_PER_IP=10
LOG_LEVEL=INFO

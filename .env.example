# Copy to .env locally. Never commit credentials.
# Uvicorn loads this file with --env-file .env (uvicorn[standard]).

# Environment: development locally; production requires both secrets below.
ENV=development
# Transcription provider: groq or cloudflare.
PROVIDER=groq
# Set locally; leave the unused provider's credentials empty.
GROQ_API_KEY=
# Whisper model requested from Groq.
GROQ_MODEL=whisper-large-v3-turbo
# Cloudflare Workers AI credentials, if PROVIDER=cloudflare.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Independent random secrets; mandatory for production or TRUSTED_PROXY=true.
SECRET_KEY=
HASH_SALT=
# SQLite, temporary audio and expiring results.
DATA_DIR=./data
# Audio minutes per user over a rolling 24-hour window.
DAILY_QUOTA_MIN=120
# Per-IP quota as a multiple of the user quota.
IP_QUOTA_MULTIPLIER=3
# Maximum duration in minutes per input.
MAX_FILE_MIN=120
# Maximum combined number of URLs and uploaded files per job.
MAX_ITEMS=5
# Per-file upload limit, in MiB. There is no total byte quota per user.
MAX_UPLOAD_MB=500
# Direct-download limit, in MiB.
MAX_DOWNLOAD_MB=500
# Daily global reservation limit in estimated USD, reset at UTC midnight.
DAILY_BUDGET_USD=0.50
# Estimated cost per audio hour; update to match your provider/model.
COST_PER_HOUR_USD=0.04
# Seconds before results are removed.
RESULT_TTL_S=3600
# Seconds per mono 16 kHz MP3 chunk.
CHUNK_SECONDS=600
# Concurrent jobs processed by this single application process.
MAX_CONCURRENT_JOBS=2
# Maximum total job time in seconds, including queue time.
JOB_TIMEOUT_S=3600
# Concurrent API requests per transcription.
PROVIDER_CONCURRENCY=3
# Enable only behind a trusted proxy; never expose that app port directly.
TRUSTED_PROXY=false
# Exact hosts allowed to use yt-dlp.
YTDLP_HOSTS=youtube.com,www.youtube.com,m.youtube.com,music.youtube.com,youtu.be
# Optional yt-dlp proxy and local cookie-file path.
YTDLP_PROXY=
YTDLP_COOKIES_FILE=
# API requests per IP per minute.
RATE_LIMIT_PER_MIN=60
# Jobs created per IP per hour.
JOBS_PER_HOUR_PER_IP=10
# Application metadata log level; sensitive logs are disabled at startup.
LOG_LEVEL=INFO
